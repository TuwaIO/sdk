{
  "name": "@tuwaio/evm-sdk",
  "version": "0.4.1",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L9 EVM add-on of the TUWA SDK: re-exports the EVM packages of Orbit Utils, SIWX, Satellite Connect, Pulsar and Nova Connect under subpaths.",
  "type": "module",
  "exports": {
    "./orbit": {
      "types": "./dist/orbit.d.ts",
      "import": "./dist/orbit.js",
      "require": "./dist/orbit.cjs"
    },
    "./pulsar": {
      "types": "./dist/pulsar.d.ts",
      "import": "./dist/pulsar.js",
      "require": "./dist/pulsar.cjs"
    },
    "./satellite": {
      "types": "./dist/satellite.d.ts",
      "import": "./dist/satellite.js",
      "require": "./dist/satellite.cjs"
    },
    "./nova-connect": {
      "types": "./dist/nova-connect.d.ts",
      "import": "./dist/nova-connect.js",
      "require": "./dist/nova-connect.cjs"
    },
    "./siwx": {
      "types": "./dist/siwx.d.ts",
      "import": "./dist/siwx.js",
      "require": "./dist/siwx.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "tuwa",
    "web3",
    "evm",
    "ethereum",
    "wagmi",
    "viem",
    "wallet",
    "wallet-connect",
    "wallets",
    "transaction",
    "tracking",
    "transaction-tracking",
    "react",
    "hooks",
    "utils",
    "typescript",
    "core",
    "headless",
    "sdk",
    "siwx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/sdk.git",
    "directory": "packages/evm-sdk"
  },
  "homepage": "https://github.com/TuwaIO/sdk",
  "bugs": {
    "url": "https://github.com/TuwaIO/sdk/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "dependencies": {
    "@tuwaio/orbit-evm": "^0.3.3",
    "@tuwaio/pulsar-evm": "^0.9.0",
    "@tuwaio/satellite-evm": "^0.9.0",
    "@tuwaio/siwx-evm": "^0.5.1"
  },
  "peerDependencies": {
    "@tuwaio/satellite-core": ">=0.7",
    "@tuwaio/sdk": ">=0.5",
    "@wagmi/core": "3.x.x",
    "viem": "2.x.x"
  },
  "devDependencies": {
    "@tuwaio/satellite-core": "^0.9.0",
    "@tuwaio/sdk": "workspace:^",
    "@wagmi/core": "^3.6.5",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "viem": "^2.57.3"
  }
}
