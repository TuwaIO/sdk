    "@tuwaio/orbit-core": "^0.5.0",
    "@tuwaio/pulsar-core": "^0.9.1",
    "@tuwaio/pulsar-react": "^0.6.1",
    "@tuwaio/satellite-core": "^0.8.0",
    "@tuwaio/satellite-react": "^0.8.0",
    "@tuwaio/siwx-core": "^0.6.0",
    "@tuwaio/siwx-react": "^0.6.0",
    "@tuwaio/siwx-server": "^0.6.0",
    "@web3icons/common": "^0.11.53",
    "@web3icons/react": "^4.1.24",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "ethereum-blockies-base64": "^1.0.2",
    "framer-motion": "14.0.0",
