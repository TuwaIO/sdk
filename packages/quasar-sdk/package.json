{
  "name": "@tuwaio/quasar-sdk",
  "version": "0.0.13",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Layer 5 (L5) of the TUWA Ecosystem. The Quasar Cloud SDK providing server-side Node.js & Edge utilities for transaction indexing, billing, and backend API integration.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react/evm": {
      "types": "./dist/react/evm.d.ts",
      "import": "./dist/react/evm.js",
      "require": "./dist/react/evm.cjs"
    },
    "./react/solana": {
      "types": "./dist/react/solana.d.ts",
      "import": "./dist/react/solana.js",
      "require": "./dist/react/solana.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup"
  },
  "keywords": [
    "tuwa",
    "web3",
    "evm",
    "ethereum",
    "solana",
    "wagmi",
    "viem",
    "gill",
    "wallet-standard",
    "wallet",
    "wallet-connect",
    "wallets",
    "transaction",
    "tracking",
    "transaction-tracking",
    "react",
    "ui",
    "ui-kit",
    "design-system",
    "hooks",
    "utils",
    "components",
    "tailwind",
    "tailwindcss",
    "typescript",
    "core",
    "headless",
    "zustand",
    "immer",
    "i18n",
    "modal",
    "toast",
    "quasar",
    "cloud",
    "sdk",
    "siwe",
    "next-auth",
    "cosmos",
    "playground",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/sdk.git",
    "directory": "packages/quasar-sdk"
  },
  "homepage": "https://github.com/TuwaIO/sdk",
  "bugs": {
    "url": "https://github.com/TuwaIO/sdk/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@solana/react": "6.x.x",
    "@tuwaio/pulsar-core": ">=0.6.0",
    "@wagmi/core": "3.x.x",
    "@wallet-standard/react": "1.x.x",
    "gill": ">=0.14.0",
    "ofetch": ">=1.5.1",
    "react": ">=19.2.0",
    "viem": "2.x.x",
    "zustand": "5.x.x"
  },
  "peerDependenciesMeta": {
    "@tuwaio/pulsar-core": {
      "optional": false
    },
    "ofetch": {
      "optional": false
    },
    "viem": {
      "optional": true
    },
    "gill": {
      "optional": true
    },
    "zustand": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@solana/react": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "@wallet-standard/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/react": "^6.9.0",
    "@tuwaio/pulsar-core": "^0.6.9",
    "@types/react": "^19.2.18",
    "@wagmi/core": "^3.6.4",
    "@wallet-standard/react": "^1.0.3",
    "ofetch": "^1.5.1",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "zustand": "^5.0.14"
  }
}
