{
  "name": "@tuwaio/quasar-sdk",
  "version": "0.0.8",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "The official server-side Node.js & Edge SDK for the TUWA Quasar Cloud.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    },
    "./react/evm": {
      "types": "./dist/react/evm.d.ts",
      "import": "./dist/react/evm.mjs",
      "require": "./dist/react/evm.js"
    },
    "./react/solana": {
      "types": "./dist/react/solana.d.ts",
      "import": "./dist/react/solana.mjs",
      "require": "./dist/react/solana.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup"
  },
  "keywords": [
    "web3",
    "transaction",
    "tracking",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/sdk.git",
    "directory": "packages/quasar-sdk"
  },
  "homepage": "https://github.com/TuwaIO/sdk",
  "bugs": {
    "url": "https://github.com/TuwaIO/sdk/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@solana/react": ">=6.9.0",
    "@tuwaio/pulsar-core": ">=0.6.0",
    "@wagmi/core": "3.x.x",
    "@wallet-standard/react": "1.x.x",
    "ofetch": ">=1.5.1",
    "react": ">=19.2.0",
    "gill": ">=0.14",
    "viem": "2.x.x",
    "zustand": "5.x.x"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    },
    "gill": {
      "optional": true
    },
    "zustand": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@solana/react": {
      "optional": true
    },
    "@wagmi/core": {
      "optional": true
    },
    "@wallet-standard/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/react": "^6.9.0",
    "@tuwaio/pulsar-core": "^0.6.3",
    "@types/react": "^19.2.14",
    "@wagmi/core": "^3.4.11",
    "@wallet-standard/react": "^1.0.2",
    "ofetch": "^1.5.1",
    "react": "^19.2.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "zustand": "^5.0.13"
  }
}
