{
  "name": "@tuwaio/quasar-sdk",
  "version": "0.4.0",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L5 client of Quasar (TUWA): the Quasar API client for Quasar Cloud and self-hosted Quasar nodes (transaction sync and history for Pulsar), and the quasar-sdk CLI that relays webhooks to localhost.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "bin": {
    "quasar-sdk": "./dist/cli.cjs"
  },
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run"
  },
  "keywords": [
    "tuwa",
    "web3",
    "quasar",
    "quasar-cloud",
    "pulsar",
    "transaction",
    "tracking",
    "transaction-tracking",
    "transaction-history",
    "webhooks",
    "api-client",
    "sdk",
    "cli",
    "typescript",
    "evm",
    "solana",
    "siwx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/sdk.git",
    "directory": "packages/quasar-sdk"
  },
  "homepage": "https://github.com/TuwaIO/sdk",
  "bugs": {
    "url": "https://github.com/TuwaIO/sdk/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "dependencies": {
    "ofetch": "^1.5.1"
  },
  "peerDependencies": {
    "@tuwaio/pulsar-core": ">=0.9",
    "@tuwaio/siwx-react": ">=0.5"
  },
  "peerDependenciesMeta": {
    "@tuwaio/siwx-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tuwaio/pulsar-core": "^0.9.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "@tuwaio/siwx-react": "^0.6.0"
  }
}
