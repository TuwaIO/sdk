{
  "name": "@tuwaio/solana-sdk",
  "version": "0.0.2",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Layer 9 (L9) of the TUWA Ecosystem. The Solana Network Adapter SDK providing Gill/Wallet-Standard transports and state watchers.",
  "type": "module",
  "exports": {
    "./orbit": {
      "types": "./dist/orbit.d.ts",
      "import": "./dist/orbit.js",
      "require": "./dist/orbit.cjs"
    },
    "./pulsar": {
      "types": "./dist/pulsar.d.ts",
      "import": "./dist/pulsar.js",
      "require": "./dist/pulsar.cjs"
    },
    "./satellite": {
      "types": "./dist/satellite.d.ts",
      "import": "./dist/satellite.js",
      "require": "./dist/satellite.cjs"
    },
    "./nova-connect": {
      "types": "./dist/nova-connect.d.ts",
      "import": "./dist/nova-connect.js",
      "require": "./dist/nova-connect.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup --watch",
    "build": "tsup"
  },
  "keywords": [
    "tuwa",
    "web3",
    "evm",
    "ethereum",
    "solana",
    "wagmi",
    "viem",
    "gill",
    "wallet-standard",
    "wallet",
    "wallet-connect",
    "wallets",
    "transaction",
    "tracking",
    "transaction-tracking",
    "react",
    "ui",
    "ui-kit",
    "design-system",
    "hooks",
    "utils",
    "components",
    "tailwind",
    "tailwindcss",
    "typescript",
    "core",
    "headless",
    "zustand",
    "immer",
    "i18n",
    "modal",
    "toast",
    "quasar",
    "cloud",
    "sdk",
    "siwe",
    "next-auth",
    "cosmos",
    "playground",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/sdk.git",
    "directory": "packages/solana-sdk"
  },
  "homepage": "https://github.com/TuwaIO/sdk",
  "bugs": {
    "url": "https://github.com/TuwaIO/sdk/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "dependencies": {
    "@tuwaio/orbit-solana": "^0.2.13",
    "@tuwaio/pulsar-solana": "^0.6.8",
    "@tuwaio/satellite-solana": "^0.3.11"
  },
  "peerDependencies": {
    "@tuwaio/sdk": "workspace:^",
    "@tuwaio/nova-connect": ">=0.4.6",
    "@wallet-standard/app": "1.1.x",
    "@wallet-standard/base": "1.1.x",
    "@wallet-standard/core": "1.x.x",
    "@wallet-standard/features": "1.1.x",
    "@wallet-standard/react": "1.x.x",
    "@wallet-standard/ui": "1.x.x",
    "@wallet-standard/ui-registry": "1.x.x",
    "gill": ">=0.14"
  },
  "devDependencies": {
    "@tuwaio/nova-connect": "^0.4.7",
    "@tuwaio/sdk": "workspace:^",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/core": "^1.1.2",
    "@wallet-standard/features": "^1.1.1",
    "@wallet-standard/react": "^1.0.3",
    "@wallet-standard/ui": "^1.0.3",
    "@wallet-standard/ui-registry": "^1.1.1",
    "gill": "^0.14.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
