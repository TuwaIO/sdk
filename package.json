{
  "name": "@tuwaio/sdk-monorepo",
  "version": "0.0.1",
  "private": true,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "description": "Monorepo for the TUWA SDK: @tuwaio/sdk (L8) and its EVM and Solana add-ons (L9), which re-export the TUWA projects for React apps, and @tuwaio/quasar-sdk (L5), the client of the Quasar API.",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "postinstall": "pnpm build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "pnpm --filter \"./packages/**\" test",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf '{}' + && find . -name dist -type d -prune -exec rm -rf '{}' + && rm -rf .turbo",
    "docs:gen": "rm -rf apps/docs/src/content/packages && typedoc && node apps/docs/typedoc/packagePages.mjs && cp -R apps/docs/typedoc/meta/. apps/docs/src/content/packages/",
    "openapi:gen": "tsx scripts/generate-openapi.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/sdk.git"
  },
  "homepage": "https://github.com/TuwaIO/sdk",
  "bugs": {
    "url": "https://github.com/TuwaIO/sdk/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tuwaio/orbit-core": "^0.5.0",
    "@tuwaio/pulsar-core": "^0.9.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
